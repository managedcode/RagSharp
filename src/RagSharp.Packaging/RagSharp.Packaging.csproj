<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>RagSharp</PackageId>
    <ProjectName>RagSharp.Packaging</ProjectName>
    <Version>0.1.0</Version>
    <Authors>RagSharp</Authors>
    <Description>RagSharp code graph skills installer and CLI tools.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://example.invalid/ragsharp</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RagSharp.CodeGraph.Cli/RagSharp.CodeGraph.Cli.csproj" PrivateAssets="all" />
    <ProjectReference Include="../RagSharp.SkillInstaller/RagSharp.SkillInstaller.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../RagSharp.CodeGraph.Cli/bin/$(Configuration)/net10.0/**" Pack="true" PackagePath="tools/net10.0/any/ragsharp-graph" />
    <None Include="../RagSharp.SkillInstaller/bin/$(Configuration)/net10.0/**" Pack="true" PackagePath="tools/net10.0/any/ragsharp" />
  </ItemGroup>
</Project>
